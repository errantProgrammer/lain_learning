% ================================================================================
% Auto-Generated Progress Dashboard Mechanism
% ================================================================================
\newwrite\targetStream
\newif\iftargetStreamOpen\targetStreamOpenfalse

\newcommand{\registerDashboard}[5]{%
	\iftargetStreamOpen
		\immediate\write\targetStream{\string\dashboardRow{#1}{#2}{#3}{#4}{#5}}%
	\fi
}

\newcommand{\dashboardRow}[5]{%
	\hyperlink{target:#1}{\textbf{\color{csecDark}#1}\ \scriptsize\color{csecCyan}\faExternalLink*} & \osBadge{#2} & \platformBadge{#3} & \difficultyBadge{#4} & \mbox{\badge[white]{csecGreen}{\faCheck\ PWNED}} & {\footnotesize #5} \tabularnewline \midrule
}

\newcommand{\renderDashboard}{%
	\IfFileExists{\jobname.targets}{%
		\begin{longtable}{@{} p{3.2cm} p{2.2cm} p{2.8cm} c c p{4.2cm} @{}}
			\toprule
			\rowcolor{csecDark}
			\textbf{\color{white}Objetivo}   &
			\textbf{\color{white}S.O.}       &
			\textbf{\color{white}Plataforma} &
			\textbf{\color{white}Dificultad} &
			\textbf{\color{white}Estado}     &
			\textbf{\color{white}Tags / Categorías} \tabularnewline
			\midrule
			\endfirsthead
			\toprule
			\rowcolor{csecDark}
			\textbf{\color{white}Objetivo}   &
			\textbf{\color{white}S.O.}       &
			\textbf{\color{white}Plataforma} &
			\textbf{\color{white}Dificultad} &
			\textbf{\color{white}Estado}     &
			\textbf{\color{white}Tags / Categorías} \tabularnewline
			\midrule
			\endhead
			\bottomrule
			\endfoot
			\input{\jobname.targets}
		\end{longtable}%
	}{%
		\begin{center}
			\small\color{csecDark}\faSync*\ \textit{El registro de objetivos se generará automáticamente tras compilar los writeups.}
		\end{center}
	}%
	\immediate\openout\targetStream=\jobname.targets\relax
	\targetStreamOpentrue
}

\AtEndDocument{%
	\iftargetStreamOpen
		\immediate\closeout\targetStream
	\fi
}

% ================================================================================
% Target Card / Summary Box (Supports multiple tags & long full-width flags)
% ================================================================================
\newcommand{\targetSummary}[9]{%
	% Anchor for direct hyperlink jumping from Dashboard
	\phantomsection\hypertarget{target:#1}{}%
	% Automatically update header & footer with machine metadata globally
	\setPlatformHeader{#3}{#1}{#7}%
	% Automatically register target metadata into the master dashboard stream (Name, OS, Platform, Difficulty, Tags)
	\registerDashboard{#1}{#5}{#3}{#4}{#6}%
	\begin{tcolorbox}[
			enhanced,
			colback=csecDark,
			colframe=csecDark,
			boxrule=0pt,
			arc=5pt,
			top=10pt, bottom=10pt, left=12pt, right=12pt
		]
		\begin{minipage}[c]{0.50\textwidth}
			{\LARGE \textbf{\color{white}#1}} \\[3pt]
			{\small \color{csecBorder}\faNetworkWired\ IP / Host:} {\textbf{\color{csecCyan}#2}} \\[2pt]
			{\small \color{csecBorder}\faCalendar*\ Fecha:} {\color{white}#7}
		\end{minipage}
		\hfill
		\begin{minipage}[c]{0.48\textwidth}
			\flushright
			\platformBadge{#3} \hspace{2pt} \difficultyBadge{#4} \\[4pt]
			\osBadge{#5} \hspace{2pt} \tagList{#6}
		\end{minipage}

		\vspace{6pt}
		\hrule height 0.5pt \color{csecNavy}
		\vspace{6pt}

		% Long Flags Section: Full width rows with auto-wrapping monospace
		\ifblank{#9}{%
			% Only one flag provided (e.g. Web lab / CTF challenge)
			\begin{tabularx}{\textwidth}{@{}l X@{}}
				\color{csecBorder}\faFlag\ \textbf{Flag / Hash:} & {\small\color{colHTB}\texttt{\detokenize{#8}}}
			\end{tabularx}
		}{%
			% User & Root flags provided
			\begin{tabularx}{\textwidth}{@{}l X@{}}
				\color{csecBorder}\faUserSecret\ \textbf{User Flag:} & {\small\color{colHTB}\texttt{\detokenize{#8}}} \\[3pt]
				\color{csecBorder}\faCrown\ \textbf{Root Flag:}      & {\small\color{colHTB}\texttt{\detokenize{#9}}}
			\end{tabularx}
		}
	\end{tcolorbox}%
}

