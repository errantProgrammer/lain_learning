	\fancyfoot[C]{\small\color{csecDark}\textbf{\currentAuthor}}
	\fancyfoot[R]{\small\color{csecDark}\textbf{\thepage\ / \pageref{LastPage}}}
}

% Command to set custom icon (either image file path or FontAwesome icon), machine name, and solve date globally (\gdef)
\newcommand{\setCustomHeader}[4][errantprogrammer]{%
	\gdef\currentPlatformHeader{#2}%
	\gdef\currentMachineName{#3}%
	\gdef\currentSolveDate{#4}%
	\gdef\currentAuthor{#1}%
}

% Helper to resolve platform icons globally across subfiles and pages (\gdef)
\newcommand{\setPlatformHeader}[3]{%
	\ifstrequal{#1}{HackTheBox}{%
		\gdef\currentPlatformHeader{{\color{black}\faCube}\ \textbf{HackTheBox}}%
	}{%
		\ifstrequal{#1}{HTB}{%
			\gdef\currentPlatformHeader{{\color{black}\faCube}\ \textbf{HackTheBox}}%
		}{%
			\ifstrequal{#1}{TryHackMe}{%
				\gdef\currentPlatformHeader{{\color{colTHM}\faFire}\ \textbf{TryHackMe}}%
			}{%
				\ifstrequal{#1}{THM}{%
					\gdef\currentPlatformHeader{{\color{colTHM}\faFire}\ \textbf{TryHackMe}}%
				}{%
					\ifstrequal{#1}{PortSwigger}{%
						\gdef\currentPlatformHeader{{\color{colPortSwigger}\faGlobe}\ \textbf{PortSwigger}}%
					}{%
						\ifstrequal{#1}{CTF}{%
							\gdef\currentPlatformHeader{{\color{colCTF}\faFlag}\ \textbf{CTF Challenge}}%
						}{%
							\gdef\currentPlatformHeader{\includegraphics[height=11pt,keepaspectratio]{#1}\ \textbf{CTF Challenge}}%
						}}}}}}%
	\gdef\currentMachineName{#2}%
	\gdef\currentSolveDate{#3}%
}

