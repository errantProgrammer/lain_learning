\NewDocumentCommand{\chaptertoc}{O{Estructura y Contenido del Capítulo} O{section}}{%
	\begingroup
	\etocsettocstyle{\begin{localtocbox}[#1]}{\end{localtocbox}}%
	\etocsettocdepth{#2}%
	\localtableofcontents
	\endgroup
}

\NewDocumentCommand{\localtoc}{O{Estructura y Contenido} O{subsection}}{%
	\begingroup
	\etocsettocstyle{\begin{localtocbox}[#1]}{\end{localtocbox}}%
	\etocsettocdepth{#2}%
	\localtableofcontents
	\endgroup
}

