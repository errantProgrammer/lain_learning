	top=8pt, bottom=6pt, left=8pt, right=8pt
}

\NewDocumentCommand{\sectiontoc}{s O{Subsecciones del Tema}}{%
	\begingroup
	\etocsettocstyle{\begin{sectiontocbox}[#2]\begin{multicols}{2}}{\end{multicols}\end{sectiontocbox}}%
	\etocsettocdepth{subsection}%
	\IfBooleanTF{#1}{%
		% Con estrella (*): incluye número (ej: 1.1.1 Nombre)
		\etocsetstyle{subsection}%
			{}%
			{}%
			{\noindent\footnotesize\hangindent=1.2em\hangafter=1\color{csecCyan}\faAngleRight\ \color{csecDark}\etoclink{\etocnumber\ \etocname}\par\vspace{2pt}}%
			{}%
	}{%
		% Sin estrella (por defecto): solo el nombre de la subsección, sin número ni página
		\etocsetstyle{subsection}%
			{}%
			{}%
			{\noindent\footnotesize\hangindent=1.2em\hangafter=1\color{csecCyan}\faAngleRight\ \color{csecDark}\etoclink{\etocname}\par\vspace{2pt}}%
			{}%
	}%
	\localtableofcontents
	\endgroup
}
