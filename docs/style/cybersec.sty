\newcommand{\setchapterimagepath}[1]{%
	\graphicspath{%
		{#1/}%
		{#1/img/}%
		{./#1/}%
		{./#1/img/}%
		{../#1/}%
		{../#1/img/}%
		{../../#1/}%
		{../../#1/img/}%
		{../../../#1/}%
		{../../../#1/img/}%
		{chapters/#1/}%
		{chapters/#1/img/}%
		{chapters/knowledge_base/#1/}%
		{chapters/knowledge_base/#1/img/}%
		{writeups/#1/}%
		{writeups/#1/img/}%
		{figure/}%
		{./figure/}%
		{../figure/}%
		{../../figure/}%
		{img/}%
		{./img/}%
		{../img/}%
		{../../img/}%
	}%
}
\newcommand{\setimgpath}[1]{\setchapterimagepath{#1}}

\newcommand{\addchapterimagepath}[1]{%
	\g@addto@macro\Ginput@path{%
		{#1/}%
		{#1/img/}%
		{./#1/}%
		{./#1/img/}%
		{../#1/}%
		{../#1/img/}%
		{../../#1/}%
		{../../#1/img/}%
		{chapters/#1/}%
		{chapters/#1/img/}%
		{chapters/knowledge_base/#1/}%
		{chapters/knowledge_base/#1/img/}%
	}%
}
\newcommand{\addimgpath}[1]{\addchapterimagepath{#1}}
