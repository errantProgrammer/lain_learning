% 1. Terminal Console Box (Minted)
\newtcblisting{terminal}[1][kali@pentest:\~{}]{
enhanced,
listing only,
listing engine=minted,
minted language=text,
minted options={
		fontsize=\footnotesize,
		breaklines,
		autogobble,
		formatcom=\color{termText}
	},
colback=termBg,
boxrule=0.8pt,
colframe=csecNavy,
arc=4pt,
top=8pt,
bottom=8pt,
left=8pt,
right=8pt,
title={%
		\tikz[baseline=-0.6ex]{
			\fill[termDotRed] (0,0) circle (3pt);
			\fill[termDotYellow] (10pt,0) circle (3pt);
			\fill[termDotGreen] (20pt,0) circle (3pt);
		}\hspace{10pt}\textbf{\color{termPrompt}#1}%
	},
coltitle=csecLight,
fonttitle=\bfseries\footnotesize,
attach boxed title to top left={xshift=6pt, yshift=-9pt},
boxed title style={
		colback=csecDark,
		colframe=csecDark,
		arc=3pt,
		boxrule=0pt,
		top=2pt, bottom=2pt, left=4pt, right=4pt
	}
}

