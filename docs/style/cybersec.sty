% ================================================================================
% Custom Badges
% ================================================================================
\newcommand{\badge}[3][white]{%
	\mbox{%
		\begin{tikzpicture}[baseline=(X.base)]
			\node[
				fill=#2,
				text=#1,
				rounded corners=2pt,
				inner sep=3.5pt,
				font=\bfseries\scriptsize
			] (X) {#3};
		\end{tikzpicture}%
	}%
}

% Single tag badge
\newcommand{\tagBadge}[1]{\badge[white]{csecPurple}{\faTag\ #1}}

% Comma-separated tag list helper (renders each item as an individual pill)
\newcommand{\tagList}[1]{%
	\foreach \t in {#1} {%
			\badge[white]{csecPurple}{\faTag\ \t}\hspace{2pt}%
		}%
}

% Severity Badges
\newcommand{\severityBadge}[1]{%
	\ifstrequal{#1}{Critical}{\badge[white]{sevCritical}{\faBiohazard\ CRITICAL}}{%
		\ifstrequal{#1}{High}{\badge[white]{sevHigh}{\faExclamationTriangle\ HIGH}}{%
			\ifstrequal{#1}{Medium}{\badge[white]{sevMedium}{\faExclamationCircle\ MEDIUM}}{%
				\ifstrequal{#1}{Low}{\badge[white]{sevLow}{\faInfoCircle\ LOW}}{%
					\ifstrequal{#1}{Info}{\badge[white]{sevInfo}{\faCheckCircle\ INFO}}{%
						\badge[white]{csecMuted}{#1}}}}}}%
}

% Difficulty Badges
\newcommand{\difficultyBadge}[1]{%
	\ifstrequal{#1}{Easy}{\badge[white]{sevInfo}{\faSmile\ EASY}}{%
		\ifstrequal{#1}{Facil}{\badge[white]{sevInfo}{\faSmile\ FÁCIL}}{%
			\ifstrequal{#1}{Medium}{\badge[white]{sevMedium}{\faMeh\ MEDIUM}}{%
				\ifstrequal{#1}{Media}{\badge[white]{sevMedium}{\faMeh\ MEDIA}}{%
					\ifstrequal{#1}{Hard}{\badge[white]{sevHigh}{\faFrown\ HARD}}{%
						\ifstrequal{#1}{Dificil}{\badge[white]{sevHigh}{\faFrown\ DIFÍCIL}}{%
							\ifstrequal{#1}{Insane}{\badge[white]{sevCritical}{\faSkullCrossbones\ INSANE}}{%
								\badge[white]{csecMuted}{#1}}}}}}}}%
}

% Platform Badges (Supports standard platforms, pwn.college, custom names & image paths)
\newcommand{\platformBadge}[1]{%
	\ifstrequal{#1}{HackTheBox}{\badge[black]{colHTB}{\faCube\ HackTheBox}}{%
		\ifstrequal{#1}{HTB}{\badge[black]{colHTB}{\faCube\ HackTheBox}}{%
			\ifstrequal{#1}{TryHackMe}{\badge[white]{colTHM}{\faFire\ TryHackMe}}{%
				\ifstrequal{#1}{THM}{\badge[white]{colTHM}{\faFire\ TryHackMe}}{%
					\ifstrequal{#1}{PortSwigger}{\badge[white]{colPortSwigger}{\faGlobe\ PortSwigger}}{%
						\ifstrequal{#1}{CTF}{\badge[white]{colCTF}{\faFlag\ CTF Challenge}}{%
							\ifstrequal{#1}{pwn.college}{\badge[white]{csecPurple}{\faGraduationCap\ pwn.college}}{%
								\ifstrequal{#1}{OverTheWire}{\badge[white]{csecNavy}{\faTerminal\ OverTheWire}}{%
									\ifstrequal{#1}{Root-Me}{\badge[white]{csecDark}{\faSkull\ Root-Me}}{%
										\IfFileExists{#1}{%
											\mbox{%
												\begin{tikzpicture}[baseline=(X.base)]
													\node[fill=colCTF, text=white, rounded corners=2pt, inner sep=3pt, font=\bfseries\scriptsize] (X) {%
														\includegraphics[height=8pt,keepaspectratio]{#1}\hspace{3pt}CTF Challenge%
													};
												\end{tikzpicture}%
											}%
										}{%
											\badge[white]{csecNavy}{\faLaptopCode\ #1}%
										}%
									}}}}}}}}}%
}

% OS Badge
\newcommand{\osBadge}[1]{%
	\ifstrequal{#1}{Linux}{\badge[white]{csecDark}{\faLinux\ Linux}}{%
		\ifstrequal{#1}{Windows}{\badge[white]{csecCyan}{\faWindows\ Windows}}{%
			\ifstrequal{#1}{Android}{\badge[white]{csecGreen}{\faAndroid\ Android}}{%
				\badge[white]{csecMuted}{\faServer\ #1}}}}%
}

% Source & Reference Badges (Libro, Web, Docs, Curso, Video, Paper, Lab, Writeup)
\newcommand{\sourceBadge}[1]{%
	\ifstrequal{#1}{Libro}{\badge[white]{csecDark}{\faBook\ Libro}}{%
		\ifstrequal{#1}{Web}{\badge[white]{csecCyan}{\faGlobe\ Web}}{%
			\ifstrequal{#1}{Docs}{\badge[white]{csecNavy}{\faFile*\ Docs}}{%
				\ifstrequal{#1}{Curso}{\badge[white]{csecPurple}{\faGraduationCap\ Curso}}{%
					\ifstrequal{#1}{Video}{\badge[white]{sevHigh}{\faVideo\ Video}}{%
						\ifstrequal{#1}{Paper}{\badge[white]{csecMuted}{\faScroll\ Paper}}{%
							\ifstrequal{#1}{Lab}{\badge[white]{csecGreen}{\faFlask\ Lab}}{%
								\ifstrequal{#1}{Writeup}{\badge[white]{colHTBbg}{\color{colHTB}\faCube\ Writeup}}{%
									\badge[white]{csecDark}{\faExternalLink*\ #1}}}}}}}}}%
}

% Structured Resource Item for Bibliography, Links, Books and Courses
\newcommand{\resourceItem}[3]{%
	\item \sourceBadge{#1}\ \textbf{#2}%
	\ifblank{#3}{}{%
		\par\vspace{1pt}\hspace*{12pt}{\footnotesize\color{csecCyan}\faLink\ #3}%
	}%
}

