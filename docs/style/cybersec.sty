\makeatletter
\tcbset{
	listing file=\jobname.listing
}
\def\tcblisting@write@path{%
	\ifdefined\import@path\import@path\fi\kvtcb@listingfile%
}
\renewenvironment{tcblisting}[1]{%
	\stepcounter{tcblisting}\edef\thetcblistingcount{\thetcblisting}%
	\tcb@layer@pushup%
	\tcb@apply@box@options{capture=minipage,#1}%
	\begingroup\tcbverbatimwrite{\tcblisting@write@path}%
}{\endtcbverbatimwrite\endgroup%
	\tcbinputlisting@core%
}
