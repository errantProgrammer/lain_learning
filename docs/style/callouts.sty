\ProvidesPackage{callouts}[2026/09/08 Modern Rounded Callouts and Alerts for Cybersecurity Theme by errantprogrammer]

% ================================================================================
% Dependencias de paquetes para Callouts
% ================================================================================
\RequirePackage{xcolor}
\RequirePackage{fontawesome5}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins}

% ================================================================================
% Paleta de colores de respaldo (si no han sido definidos previamente)
% ================================================================================
\providecolor{csecDark}{HTML}{0F172A}       % Texto principal oscuro
\providecolor{csecNavy}{HTML}{1E293B}       % Fondo navy oscuro
\providecolor{csecBorder}{HTML}{CBD5E1}     % Borde sutil
\providecolor{csecCyan}{HTML}{0284C7}       % Acento cyan / información
\providecolor{csecGreen}{HTML}{059669}      % Acento verde / mitigación / tips
\providecolor{sevMedium}{HTML}{D97706}      % Ámbar / advertencias
\providecolor{sevCritical}{HTML}{DC2626}    % Rojo / alertas críticas
\providecolor{csecPurple}{HTML}{7C3AED}     % Púrpura / aprendizajes

% ================================================================================
% 1. Cajas de Información y Notas Clave (Cyan)
% ================================================================================
\newtcolorbox{notebox}[1][Nota Clave]{
    enhanced,
    arc=5pt,
    toprule=0.7pt,
    bottomrule=0.7pt,
    rightrule=0.7pt,
    leftrule=4pt,
    colframe=csecCyan,
    colback=csecCyan!5,
    top=7pt, bottom=7pt, left=10pt, right=10pt,
    title={{\large\color{csecCyan}\faInfoCircle}\hspace{6pt}\textbf{\color{csecDark}#1}},
    attach title to upper={\par\vspace{4pt}{\color{csecCyan!35}\hrule height 0.5pt}\vspace{6pt}},
    coltitle=csecDark,
    fonttitle=\normalsize
}

